# Maintainer: Val <val@lincast.org>
pkgname=lincast-chat
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, low-latency native VoIP and screen sharing client for Linux"
arch=('x86_64')
url="https://github.com/LinCastr/lincast-chat"
license=('AGPL-3.0-or-later')
depends=(
    'glibc'
    'gcc-libs'
    'pipewire'
    'openssl'
    'libxkbcommon'
    'wayland'
    'libx11'
    'gtk3'
    'hicolor-icon-theme'
)
makedepends=(
    'cargo'
    'desktop-file-utils'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked --manifest-path v2/Cargo.toml
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    desktop-file-validate lincast-chat.desktop
    cargo test --manifest-path v2/Cargo.toml
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
}
